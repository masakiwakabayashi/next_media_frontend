{
  "compilerOptions": {
    "target": "ES2022",
    // console を使うため DOM の型を含める（Node / ブラウザ / React Native のどこでも console はある）
    "lib": ["ES2022", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
